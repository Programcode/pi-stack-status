{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-stack-status",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Account: `wrangler login`, or the CLOUDFLARE_ACCOUNT_ID environment variable.
  "workers_dev": true,
  "routes": [{ "pattern": "status.pi-stack.org", "custom_domain": true }],
  // A namespace id is a public identifier. It does not grant access.
  // Forks should replace it with a namespace from their own account.
  "kv_namespaces": [{ "binding": "STATE", "id": "396d35acdd3c463abf394096fe0c458f" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
